<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.dsy1102.fonda.controller.PrincipalController"
            stylesheets="@styles.css" styleClass="vista">
    <top>
        <VBox spacing="12">
            <Label text="Fonda San Belarmino" styleClass="titulo"/>
            <Label text="Bebidas de Fiestas Patrias" styleClass="subtitulo"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Nombre de la bebida" HBox.hgrow="ALWAYS"/>
            </HBox>
            <padding><Insets bottom="12"/></padding>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tblBebidas">
            <placeholder>
                <Label text="No hay bebidas para mostrar. Usa &quot;Nueva&quot; para registrar una."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colVolumen" text="Volumen (ml)" prefWidth="110" styleClass="numero"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80" styleClass="numero"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100" styleClass="numero"/>
                <TableColumn fx:id="colRestringida" text="Venta restringida" prefWidth="130"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="btnNueva" text="Nueva" onAction="#onNueva" styleClass="primario"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar" styleClass="peligro"/>
            <Button fx:id="btnVender" text="Vender" onAction="#onVender"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" styleClass="contador"/>
            <padding><Insets top="12"/></padding>
        </HBox>
    </bottom>
</BorderPane>
